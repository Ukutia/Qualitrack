// Qualitrack — esquema de datos (MVP, Criterio 9 CNA)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentSource {
  UPLOAD
  GOOGLE_DRIVE
  DROPBOX
}

enum AssociationStatus {
  PROPOSED
  VALIDATED
  NOT_VALIDATED
}

enum HistoryAction {
  PROPOSED
  VALIDATED
  REJECTED
}

enum SectionChange {
  NONE
  ADDED
  REMOVED
  RENAMED
}

