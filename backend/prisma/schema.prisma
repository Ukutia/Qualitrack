model Document {
  id            Int            @id @default(autoincrement())
  originalName  String
  storedName    String         @unique
  format        String // pdf | docx | xlsx
  sizeBytes     Int
  storagePath   String
  source        DocumentSource @default(UPLOAD)
  cloudFileId   String?
  cloudLocation String?
  documentDate  DateTime       @default(now()) // base para antigüedad (HU02)
  extractedText String?        @db.Text
  uploadedAt    DateTime       @default(now())

  uploadedBy   User @relation(fields: [uploadedById], references: [id])
  uploadedById Int

  deletedAt DateTime? // null = activo, fecha = en papelera

  associations Association[]
  chunks DocumentChunk[]
}

model Association {
  id               Int               @id @default(autoincrement())
  document         Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId       Int
  subcriterion     Subcriterion      @relation(fields: [subcriterionId], references: [id])
  subcriterionId   Int
  status           AssociationStatus @default(PROPOSED)
  justification    String?           @db.Text
  evidenceFragment String?           @db.Text
  confidence       Float             @default(0)
  createdAt        DateTime          @default(now())

  validatedBy   User?     @relation("ValidatedBy", fields: [validatedById], references: [id])
  validatedById Int?
  validatedAt   DateTime?

  history AssociationHistory[]

  @@unique([documentId, subcriterionId])
}

model AssociationHistory {
  id            Int           @id @default(autoincrement())
  association   Association   @relation(fields: [associationId], references: [id], onDelete: Cascade)
  associationId Int
  action        HistoryAction
  user          User          @relation(fields: [userId], references: [id])
  userId        Int
  createdAt     DateTime      @default(now())
  snapshot      Json?
}

model CloudConnection {
  id           Int       @id @default(autoincrement())
  user         User      @relation(fields: [userId], references: [id])
  userId       Int
  provider     String // "google"
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
}

model DocumentChunk {
  id             Int      @id @default(autoincrement())
  documentId     Int
  chunkIndex     Int
  content        String   @db.Text
  embedding      Unsupported("vector(768)")?
  embeddingModel String   @default("Qwen/Qwen3-Embedding-0.6B")
  createdAt      DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
}

model Topic {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  createdBy   User @relation(fields: [createdById], references: [id])
  createdById Int

  @@index([createdById])
}