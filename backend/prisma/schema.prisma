model Criterion {
  id          Int            @id @default(autoincrement())
  code        String         @unique // "9"
  name        String
  description String?
  subcriteria Subcriterion[]
}

model Subcriterion {
  id                    Int       @id @default(autoincrement())
  criterion             Criterion @relation(fields: [criterionId], references: [id])
  criterionId           Int
  code                  String // "9.1.1"
  name                  String
  description           String?
  level                 Int       @default(1) // 1 = obligatorio, 2 = avanzado, 3 = excelencia
  required              Boolean   @default(true)
  keywords              String[] // alimenta el clasificador mock (HU01)
  acceptedEvidenceTypes String[] // tipos de evidencia aceptados (detalle HU02)

  associations Association[]

  @@unique([criterionId, code])
}

model ReportStructureVersion {
  id         Int             @id @default(autoincrement())
  version    Int             @unique
  uploadedAt DateTime        @default(now())
  active     Boolean         @default(false)
  note       String? // ej. "Restaurada desde versión 3"
  sections   ReportSection[]

  uploadedBy   User? @relation(fields: [uploadedById], references: [id])
  uploadedById Int?
}

model ReportSection {
  id          Int                    @id @default(autoincrement())
  version     ReportStructureVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId   Int
  code        String
  name        String
  description String?
  required    Boolean                @default(true)
  order       Int                    @default(0)
  changeType  SectionChange          @default(NONE)

  parent   ReportSection?  @relation("SectionChildren", fields: [parentId], references: [id])
  parentId Int?
  children ReportSection[] @relation("SectionChildren")
}

/// Borrador del informe redactado dentro de la plataforma (HU redacción).
/// `contentHtml` guarda el formato aplicado (título, negrita, cursiva, lista);
/// `contentText` es el texto plano derivado, base para la revisión de
/// incoherencias y las sugerencias de respaldo documental.
model ReportDraft {
  id          Int      @id @default(autoincrement())
  title       String   @default("Borrador sin título")
  contentHtml String   @default("") @db.Text
  contentText String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User @relation(fields: [authorId], references: [id])
  authorId Int

  versions ReportDraftVersion[]

  @@index([authorId, updatedAt])
}

