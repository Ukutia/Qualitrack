// Qualitrack — esquema de datos (MVP, Criterio 9 CNA)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentSource {
  UPLOAD
  GOOGLE_DRIVE
  DROPBOX
}

enum AssociationStatus {
  PROPOSED
  VALIDATED
  NOT_VALIDATED
}

enum HistoryAction {
  PROPOSED
  VALIDATED
  REJECTED
}

enum SectionChange {
  NONE
  ADDED
  REMOVED
  RENAMED
}

enum DocumentRequestStatus {
  PENDING
  PAUSED
  CANCELLED
  RECEIVED
}

enum RequestEmailType {
  INITIAL
  REMINDER
  RESUMED
}

enum RequestEmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  /// Rol de acceso (EP 1.1 · EP 1.2): "admin" | "user" | "ingestor".
  /// Los permisos de cada rol se declaran en src/config/roles.js.
  role         String   @default("admin")
  /// Cargo dentro del equipo (HU18). Solo letras y espacios.
  cargo        String   @default("Sin cargo registrado")
  createdAt    DateTime @default(now())

  documents           Document[]
  validatedAssocs     Association[]            @relation("ValidatedBy")
  history             AssociationHistory[]
  cloudConns          CloudConnection[]
  structureVersions   ReportStructureVersion[]
  reportDrafts        ReportDraft[]
  reportDraftVersions ReportDraftVersion[]
  topics              Topic[]
  documentRequests    DocumentRequest[]
  permissions         UserPermission[]
  assignedMilestones Milestone[] @relation("Responsible")
  createdMilestones Milestone[] @relation("MilestoneCreator")
  completedMilestones Milestone[] @relation("MilestoneCompleter")
}

/// Immutable through the API. Actor snapshot survives account/resource changes.
model SecurityEvent {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  actorId Int?
  actorEmail String?
  action String
  resourceType String
  resourceId String?
  result String
  @@index([createdAt, id])
}

model Milestone {
  id Int @id @default(autoincrement())
  title String @db.VarChar(100)
  dueDate String @db.VarChar(10)
  responsibleId Int
  responsible User @relation("Responsible", fields: [responsibleId], references: [id])
  createdById Int
  createdBy User @relation("MilestoneCreator", fields: [createdById], references: [id])
  completedAt DateTime? @db.Timestamptz(3)
  completedById Int?
  completedBy User? @relation("MilestoneCompleter", fields: [completedById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks MilestoneTask[]
  @@index([dueDate])
}

model MilestoneTask {
  id Int @id @default(autoincrement())
  title String @db.VarChar(200)
  completed Boolean @default(false)
  milestoneId Int
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

/// Permiso personalizado de un integrante sobre un módulo (HU19). Sin fila para
/// un módulo rige la plantilla de su rol (src/config/permissions.js).
model UserPermission {
  id        Int      @id @default(autoincrement())
  userId    Int
  /// Clave de MODULES en src/config/permissions.js.
  module    String
  /// "lectura" | "escritura" | "denegado".
  level     String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

/// Solicitud de una evidencia a una persona externa. El token en claro se
/// conserva cifrado únicamente para poder incluirlo en correos y, durante la
/// primera etapa de la HU, mostrarlo al creador. `tokenHash` será la credencial
/// consultada por los endpoints públicos cuando los enlaces sean habilitados.
model DocumentRequest {
  id                      Int                   @id @default(autoincrement())
  recipientEmail          String
  description             String                @db.Text
  status                  DocumentRequestStatus @default(PENDING)
  reminderIntervalMinutes Int
  nextReminderAt          DateTime?
  tokenHash               String?               @unique
  tokenEncrypted          String?               @db.Text
  tokenVersion            Int                   @default(1)
  tokenCreatedAt          DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  createdBy   User @relation(fields: [createdById], references: [id])
  createdById Int

  document   Document? @relation(fields: [documentId], references: [id])
  documentId Int?      @unique

  emails DocumentRequestEmail[]

  @@index([status, nextReminderAt])
  @@index([createdById, createdAt])
}

/// Registro lógico de un correo asociado a una versión del token. No conserva
/// el token: al enviar se usa únicamente el token vigente de la solicitud.
model DocumentRequestEmail {
  id                Int                @id @default(autoincrement())
  request           DocumentRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId         Int
  tokenVersion      Int
  type              RequestEmailType
  status            RequestEmailStatus @default(PENDING)
  attemptCount      Int                @default(0)
  nextAttemptAt     DateTime           @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  providerMessageId String?
  lastError         String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([requestId, tokenVersion])
  @@index([status, nextAttemptAt])
}

model Criterion {
  id          Int            @id @default(autoincrement())
  code        String         @unique // "9"
  name        String
  description String?
  subcriteria Subcriterion[]
}

model Subcriterion {
  id                    Int       @id @default(autoincrement())
  criterion             Criterion @relation(fields: [criterionId], references: [id])
  criterionId           Int
  code                  String // "9.1.1"
  name                  String
  description           String?
  level                 Int       @default(1) // 1 = obligatorio, 2 = avanzado, 3 = excelencia
  required              Boolean   @default(true)
  keywords              String[] // alimenta el clasificador mock (HU01)
  acceptedEvidenceTypes String[] // tipos de evidencia aceptados (detalle HU02)

  associations Association[]

  @@unique([criterionId, code])
}

model ReportStructureVersion {
  id         Int             @id @default(autoincrement())
  version    Int             @unique
  uploadedAt DateTime        @default(now())
  active     Boolean         @default(false)
  note       String? // ej. "Restaurada desde versión 3"
  sections   ReportSection[]

  uploadedBy   User? @relation(fields: [uploadedById], references: [id])
  uploadedById Int?
}

model ReportSection {
  id           Int                    @id @default(autoincrement())
  version      ReportStructureVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId    Int
  code         String
  name         String
  description  String?
  requirements Json?
  required     Boolean                @default(true)
  order        Int                    @default(0)
  changeType   SectionChange          @default(NONE)

  parent        ReportSection?       @relation("SectionChildren", fields: [parentId], references: [id])
  parentId      Int?
  children      ReportSection[]      @relation("SectionChildren")
  draftSections ReportDraftSection[]
}

/// Borrador del informe redactado dentro de la plataforma (HU redacción).
/// `contentHtml` guarda el formato aplicado (título, negrita, cursiva, lista);
/// `contentText` es el texto plano derivado, base para la revisión de
/// incoherencias y las sugerencias de respaldo documental.
model ReportDraft {
  id          Int      @id @default(autoincrement())
  title       String   @default("Borrador sin título")
  contentHtml String   @default("") @db.Text
  contentText String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User @relation(fields: [authorId], references: [id])
  authorId Int

  versions           ReportDraftVersion[]
  sections           ReportDraftSection[]
  generationSections ReportGenerationSection[]

  @@index([authorId, updatedAt])
}

/// Contenido editable asociado a una sección de la estructura oficial.
/// ReportDraft.contentHtml se conserva para compatibilidad con borradores existentes.
model ReportDraftSection {
  id                 Int           @id @default(autoincrement())
  draft              ReportDraft   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId            Int
  structureSection   ReportSection @relation(fields: [structureSectionId], references: [id], onDelete: Cascade)
  structureSectionId Int
  contentHtml        String        @default("") @db.Text
  contentText        String        @default("") @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([draftId, structureSectionId])
  @@index([draftId, updatedAt])
}

/// Configuración editable de secciones usada para generar contenido.
/// Se mantiene separada de la plantilla oficial ReportSection.
model ReportGenerationSection {
  id           Int         @id @default(autoincrement())
  draft        ReportDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId      Int
  code         String
  name         String
  description  String?     @db.Text
  requirements Json?
  contentHtml  String      @default("") @db.Text
  contentText  String      @default("") @db.Text
  order        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([draftId, order])
}

/// Instantánea de un ReportDraft en un punto del tiempo. No se crea en cada
/// autoguardado (saturaría el historial): `updateDraft` solo respalda el
/// estado anterior cuando ha pasado un intervalo mínimo desde la última
/// instantánea, o al restaurar una versión previa.
model ReportDraftVersion {
  id          Int         @id @default(autoincrement())
  draft       ReportDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId     Int
  version     Int
  title       String
  contentHtml String      @default("") @db.Text
  contentText String      @default("") @db.Text
  createdAt   DateTime    @default(now())

  createdBy   User? @relation(fields: [createdById], references: [id])
  createdById Int?

  @@unique([draftId, version])
}

model Document {
  id                      Int            @id @default(autoincrement())
  originalName            String
  storedName              String         @unique
  format                  String // pdf | docx | xlsx
  sizeBytes               Int
  storagePath             String
  source                  DocumentSource @default(UPLOAD)
  cloudFileId             String?
  cloudLocation           String?
  documentDate            DateTime       @default(now()) // base para antigüedad (HU02)
  extractedText           String?        @db.Text
  /// Estado del flujo de análisis documental: RECEIVED, PREPARING_ANALYSIS, SENT_TO_ANALYZER,
  /// RECEIVED_BY_ANALYZER, EXTRACTING_CONTENT, ANALYZING_CONTENT, RECEIVING_RESULT,
  /// COMPLETED y ERROR.
  analysisStatus          String?        @default("RECEIVED")
  /// PROCESSING mientras se generan embeddings; READY al terminar; FAILED si falla.
  analysisError           String?
  /// Cuando cambio analysisStatus por ultima vez. Permite reencolar los
  /// documentos que un worker tomo y nunca termino.
  analysisStatusUpdatedAt DateTime?
  /// Momento en que comenzó el intento actual de análisis.
  /// No cambia con los estados intermedios y permite medir el timeout de 3 minutos.
  analysisStartedAt       DateTime?
  /// Explicacion del analisis cuando NO genera asociacion: sin esto, un
  /// documento descartado por la IA se ve igual que uno nunca analizado.
  analysisSummary         String?        @db.Text
  /// Que motor decidio: el modelo local, gemini o el respaldo por keywords.
  /// Hace visible en la interfaz cuando la IA no fue la que decidio.
  analysisEngine          String?
  vectorizationStatus     String         @default("READY")
  uploadedAt              DateTime       @default(now())

  uploadedBy            User    @relation(fields: [uploadedById], references: [id])
  uploadedById          Int
  /// Correo del destinatario cuando el documento fue cargado mediante una
  /// solicitud pública. La propiedad interna sigue siendo `uploadedById`.
  externalUploaderEmail String?

  deletedAt DateTime? // null = activo, fecha = en papelera

  associations Association[]
  chunks       DocumentChunk[]
  request      DocumentRequest?

  /// El worker consulta la cola cada pocos segundos; sin este indice cada
  /// sondeo recorre la tabla entera.
  @@index([analysisStatus, deletedAt])
}

model Association {
  id               Int               @id @default(autoincrement())
  document         Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId       Int
  subcriterion     Subcriterion      @relation(fields: [subcriterionId], references: [id])
  subcriterionId   Int
  status           AssociationStatus @default(PROPOSED)
  justification    String?           @db.Text
  evidenceFragment String?           @db.Text
  confidence       Float             @default(0)
  /// Que produjo esta asociacion: el modelo local, gemini, el respaldo por
  /// keywords o "manual". Va en la asociacion y no en el documento porque una
  /// reasignacion manual no debe atribuirse al modelo que analizo antes.
  engine           String?
  createdAt        DateTime          @default(now())

  validatedBy   User?     @relation("ValidatedBy", fields: [validatedById], references: [id])
  validatedById Int?
  validatedAt   DateTime?

  history AssociationHistory[]

  @@index([documentId, subcriterionId])
}

model AssociationHistory {
  id            Int           @id @default(autoincrement())
  association   Association   @relation(fields: [associationId], references: [id], onDelete: Cascade)
  associationId Int
  action        HistoryAction
  user          User          @relation(fields: [userId], references: [id])
  userId        Int
  createdAt     DateTime      @default(now())
  snapshot      Json?
}

model CloudConnection {
  id           Int       @id @default(autoincrement())
  user         User      @relation(fields: [userId], references: [id])
  userId       Int
  provider     String // "google"
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
}

model DocumentChunk {
  id             Int                         @id @default(autoincrement())
  documentId     Int
  chunkIndex     Int
  content        String                      @db.Text
  embedding      Unsupported("vector(768)")?
  embeddingModel String                      @default("Qwen/Qwen3-Embedding-0.6B")
  createdAt      DateTime                    @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
}

model Topic {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  createdBy   User @relation(fields: [createdById], references: [id])
  createdById Int

  @@index([createdById])
}

/// HU25 · Contador de intentos fallidos y bloqueo temporal por correo
/// (normalizado en minúsculas). Se usa también para correos no registrados,
/// para no revelar qué cuentas existen.
model LoginThrottle {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// HU25 · Registro de intentos de ingreso. Nunca guarda la contraseña.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  ip        String?
  success   Boolean
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
